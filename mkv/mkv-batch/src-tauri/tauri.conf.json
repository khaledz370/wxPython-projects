{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MKV Batch",
  "version": "2.0.0",
  "identifier": "com.kz370.mkvbatch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MKV Batch",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
